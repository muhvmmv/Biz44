generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String               @id @default(uuid())
  firstName      String
  lastName       String
  email          String               @unique
  password       String
  companyId      String
  company        Company              @relation(fields: [companyId], references: [id])
  /// admin, manager, accountant, storekeeper or sales (see src/lib/permissions.ts)
  role           String               @default("admin")
  /// Deactivated users cannot sign in; their history is kept.
  isActive       Boolean              @default(true)
  /// Set when the person deleted their account: name and email are erased,
  /// the records they created stay with the company.
  deletedAt      DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  locationAccess UserLocationAccess[]

  @@map("users")
}

model Company {
  id                  String            @id @default(uuid())
  name                String
  email               String?
  phone               String?
  address             String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  users               User[]
  purchases           Purchase[]
  customers           Customer[]
  suppliers           Supplier[]
  employees           Employee[]
  products            Product[]
  invoices            Invoice[]
  accounts            Account[]
  transactions        Transaction[]
  stockMovements      StockMovement[]
  payments            Payment[]
  payrolls            Payroll[]
  attendance          Attendance[]
  reportNotes         ReportNote[]
  leaves              Leave[]
  batches             InventoryBatch[]
  locations           Location[]
  purchasePayments    PurchasePayment[]
  journalEntries      JournalEntry[]
  boms                Bom[]
  productionOrders    ProductionOrder[]
  /// When this company switched to the double-entry journal. Account balances
  /// at that moment were carried in as an opening entry; P&L history before
  /// it comes from the older transaction records.
  ledgerStartedAt     DateTime?
  businessType        String?
  industry            String?
  country             String?
  currency            String            @default("USD")
  /// VAT charged on sales, in percent (0 = not charging VAT).
  vatRate             Float             @default(0)
  vatNumber           String?
  teamSize            String?
  onboardingCompleted Boolean           @default(false)
  stockTransfers      StockTransfer[]
  creditNotes         CreditNote[]
  customerDeposits    CustomerDeposit[]
}

model Customer {
  id        String    @id @default(uuid())
  companyId String
  company   Company   @relation(fields: [companyId], references: [id])
  firstName String
  lastName  String
  email     String?
  phone     String?
  address   String?
  invoices  Invoice[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  productionOrders ProductionOrder[]
  deposits         CustomerDeposit[]

  @@map("customers")
}

model Supplier {
  id        String           @id @default(uuid())
  companyId String
  company   Company          @relation(fields: [companyId], references: [id])
  purchases Purchase[]
  batches   InventoryBatch[]
  name      String
  email     String?
  phone     String?
  address   String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@map("suppliers")
}

model Employee {
  id         String       @id @default(uuid())
  companyId  String
  company    Company      @relation(fields: [companyId], references: [id])
  firstName  String
  lastName   String
  email      String?
  phone      String?
  position   String?
  salary     Float        @default(0)
  hireDate   DateTime?
  payrolls   Payroll[]
  attendance Attendance[]
  leaves     Leave[]
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@map("employees")
}

model Product {
  id                  String               @id @default(uuid())
  companyId           String
  company             Company              @relation(fields: [companyId], references: [id])
  name                String
  sku                 String?
  description         String?
  price               Float                @default(0)
  cost                Float                @default(0)
  totalCostValue      Float                @default(0)
  quantity            Float                @default(0)
  reorderPoint        Float                @default(0)
  /// raw_material | packaging | finished_good
  itemType            String               @default("finished_good")
  /// Unit of measure, e.g. pcs, kg, g, l, ml, bag, roll, carton
  unit                String               @default("pcs")
  invoiceItems        InvoiceItem[]
  stockMovements      StockMovement[]
  purchaseItems       PurchaseItem[]
  batches             InventoryBatch[]
  boms                Bom[]
  bomComponents       BomLine[]
  productionOrders    ProductionOrder[]    @relation("ProductionOutput")
  productionMaterials ProductionMaterial[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  transferLines StockTransferLine[]

  @@map("products")
}

model Purchase {
  id             String            @id @default(uuid())
  companyId      String
  company        Company           @relation(fields: [companyId], references: [id])
  locationId     String?
  location       Location?         @relation(fields: [locationId], references: [id])
  supplierId     String?
  supplier       Supplier?         @relation(fields: [supplierId], references: [id])
  reference      String?
  date           DateTime          @default(now())
  dueDate        DateTime?
  subtotal       Float             @default(0)
  /// VAT charged by the supplier (recoverable input VAT); total = subtotal + taxTotal.
  taxTotal       Float             @default(0)
  total          Float             @default(0)
  amountPaid     Float             @default(0)
  /// Value of goods returned to the supplier and deducted from this purchase.
  /// Amount owed = total - amountPaid - returnedAmount.
  returnedAmount Float             @default(0)
  status         String            @default("unpaid")
  notes          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  items          PurchaseItem[]
  batches        InventoryBatch[]
  payments       PurchasePayment[]

  @@index([companyId, status])
  @@index([companyId, locationId])
  @@map("purchases")
}

model PurchaseItem {
  id         String   @id @default(uuid())
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  quantity   Float
  unitCost   Float
  total      Float

  @@map("purchase_items")
}

model Invoice {
  id              String        @id @default(uuid())
  companyId       String
  company         Company       @relation(fields: [companyId], references: [id])
  locationId      String?
  location        Location?     @relation(fields: [locationId], references: [id])
  customerId      String?
  customer        Customer?     @relation(fields: [customerId], references: [id])
  customerName    String?
  customerAddress String?
  customerEmail   String?
  customerPhone   String?
  /// Unique within a company (each company numbers its own invoices INV-0001, INV-0002, ...).
  invoiceNumber   String
  status          String        @default("draft")
  subtotal        Float         @default(0)
  discountTotal   Float         @default(0)
  taxTotal        Float         @default(0)
  /// VAT rate applied to this invoice, in percent.
  taxRate         Float         @default(0)
  total           Float         @default(0)
  amountPaid      Float         @default(0)
  notes           String?
  dueDate         DateTime?
  finalizedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  items           InvoiceItem[]
  payments        Payment[]

  /// Total of credit notes against this invoice.
  creditedAmount Float        @default(0)
  creditNotes    CreditNote[]

  /// The production order this invoice bills, if any; its deposits are applied on finalizing.
  productionOrderId String?
  productionOrder   ProductionOrder? @relation(fields: [productionOrderId], references: [id])

  @@unique([companyId, invoiceNumber])
  @@index([companyId, locationId])
  @@map("invoices")
}

model InvoiceItem {
  id          String   @id @default(uuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id])
  description String
  quantity    Float    @default(1)
  unitPrice   Float    @default(0)
  total       Float    @default(0)

  creditLines CreditNoteLine[]

  @@map("invoice_items")
}

model Payment {
  id         String    @id @default(uuid())
  companyId  String
  company    Company   @relation(fields: [companyId], references: [id])
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id])
  invoiceId  String?
  invoice    Invoice?  @relation(fields: [invoiceId], references: [id])
  amount     Float
  method     String    @default("cash")
  reference  String?
  notes      String?
  paidAt     DateTime  @default(now())
  createdAt  DateTime  @default(now())

  /// Set when this payment is a customer deposit applied to the invoice.
  depositId String?
  deposit   CustomerDeposit? @relation(fields: [depositId], references: [id])

  @@index([companyId, locationId])
  @@map("payments")
}

model Account {
  id            String        @id @default(uuid())
  companyId     String
  company       Company       @relation(fields: [companyId], references: [id])
  name          String
  /// asset | liability | equity | revenue | expense
  type          String
  /// Cached balance in the account's normal direction (debit for assets and
  /// expenses, credit for liabilities, equity and revenue). Kept in step with
  /// the journal by the ledger service.
  balance       Float         @default(0)
  /// Fixed role used by the system to find this account regardless of its
  /// name (cash, ar, inventory, ap, sales, cogs, ...). Null for user accounts.
  systemKey     String?
  /// Chart-of-accounts code, e.g. 1000.
  code          String?
  /// For asset accounts that hold money: "cash" or "bank".
  subtype       String?
  bankName      String?
  accountNumber String?
  isActive      Boolean       @default(true)
  transactions  Transaction[]
  journalLines  JournalLine[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([companyId, systemKey])
  @@map("accounts")
}

/// One balanced accounting event. Sum of debits = sum of credits.
model JournalEntry {
  id          String        @id @default(uuid())
  companyId   String
  company     Company       @relation(fields: [companyId], references: [id])
  locationId  String?
  location    Location?     @relation(fields: [locationId], references: [id])
  date        DateTime      @default(now())
  description String
  /// What created it: opening_balance, invoice, invoice_payment, invoice_cancel,
  /// purchase, purchase_payment, supplier_return, opening_stock, stock_adjustment,
  /// expense, payroll, transfer, manual
  sourceType  String
  sourceId    String?
  reference   String?
  createdById String?
  createdAt   DateTime      @default(now())
  lines       JournalLine[]

  @@index([companyId, date])
  @@index([companyId, sourceType, sourceId])
  @@map("journal_entries")
}

model JournalLine {
  id        String       @id @default(uuid())
  entryId   String
  entry     JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  companyId String
  accountId String
  account   Account      @relation(fields: [accountId], references: [id])
  debit     Decimal      @default(0) @db.Decimal(18, 2)
  credit    Decimal      @default(0) @db.Decimal(18, 2)
  memo      String?

  @@index([companyId, accountId])
  @@index([entryId])
  @@map("journal_lines")
}

model Transaction {
  id          String    @id @default(uuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id])
  locationId  String?
  location    Location? @relation(fields: [locationId], references: [id])
  accountId   String
  account     Account   @relation(fields: [accountId], references: [id])
  type        String
  description String?
  amount      Float
  date        DateTime  @default(now())
  createdAt   DateTime  @default(now())

  @@index([companyId, locationId])
  @@map("transactions")
}

model StockMovement {
  id         String          @id @default(uuid())
  companyId  String
  company    Company         @relation(fields: [companyId], references: [id])
  locationId String?
  location   Location?       @relation(fields: [locationId], references: [id])
  productId  String
  product    Product         @relation(fields: [productId], references: [id])
  batchId    String?
  batch      InventoryBatch? @relation(fields: [batchId], references: [id])
  type       String
  quantity   Float
  balance    Float
  unitCost   Float           @default(0)
  totalCost  Float           @default(0)
  reference  String?
  notes      String?
  createdAt  DateTime        @default(now())

  @@index([productId, createdAt])
  @@index([reference])
  @@index([companyId, locationId])
  @@map("stock_movements")
}

model InventoryBatch {
  id                   String            @id @default(uuid())
  companyId            String
  company              Company           @relation(fields: [companyId], references: [id])
  locationId           String?
  location             Location?         @relation(fields: [locationId], references: [id])
  productId            String
  product              Product           @relation(fields: [productId], references: [id])
  supplierId           String?
  supplier             Supplier?         @relation(fields: [supplierId], references: [id])
  purchaseId           String?
  purchase             Purchase?         @relation(fields: [purchaseId], references: [id])
  quantityReceived     Float
  quantityRemaining    Float
  /// Set on finished goods made by a production order (traceability).
  productionOrderId    String?
  productionOrder      ProductionOrder?  @relation(fields: [productionOrderId], references: [id])
  productionIssues     ProductionIssue[]
  unitCost             Float
  sellingPriceSnapshot Float             @default(0)
  reference            String?
  receivedAt           DateTime          @default(now())
  isLegacy             Boolean           @default(false)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  stockMovements       StockMovement[]

  @@index([productId, receivedAt])
  @@index([productId, quantityRemaining])
  @@index([companyId, createdAt])
  @@map("inventory_batches")
}

model Payroll {
  id         String    @id @default(uuid())
  companyId  String
  company    Company   @relation(fields: [companyId], references: [id])
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id])
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id])
  period     String
  gross      Float
  deductions Float     @default(0)
  net        Float
  paidAt     DateTime?
  status     String    @default("pending")
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@map("payrolls")
}

model Attendance {
  id         String    @id @default(uuid())
  companyId  String
  company    Company   @relation(fields: [companyId], references: [id])
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id])
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id])
  date       DateTime
  status     String
  notes      String?
  createdAt  DateTime  @default(now())

  @@map("attendance")
}

model Leave {
  id         String    @id @default(uuid())
  companyId  String
  company    Company   @relation(fields: [companyId], references: [id])
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id])
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id])
  type       String
  startDate  DateTime
  endDate    DateTime
  reason     String?
  status     String    @default("pending")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@map("leaves")
}

model ReportNote {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  title     String
  content   String
  category  String   @default("general") // sales, inventory, finance, general
  date      DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("report_notes")
}

model Location {
  id               String               @id @default(uuid())
  companyId        String
  company          Company              @relation(fields: [companyId], references: [id])
  name             String
  city             String?
  address          String?
  phone            String?
  email            String?
  status           String               @default("active") // active | inactive
  isDefault        Boolean              @default(false) // set true for the auto-created "Main" location
  /// "factory" (makes, stores and sells) or "store" (receives stock and sells; no production)
  kind             String               @default("factory")
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  userAccess       UserLocationAccess[]
  invoices         Invoice[]
  payments         Payment[]
  transactions     Transaction[]
  stockMovements   StockMovement[]
  purchases        Purchase[]
  batches          InventoryBatch[]
  attendance       Attendance[]
  leaves           Leave[]
  payrolls         Payroll[]
  purchasePayments PurchasePayment[]
  journalEntries   JournalEntry[]
  productionOrders ProductionOrder[]

  transfersOut StockTransfer[] @relation("TransferFrom")
  transfersIn  StockTransfer[] @relation("TransferTo")

  creditNotes CreditNote[]

  customerDeposits CustomerDeposit[]

  @@index([companyId, status])
  @@map("locations")
}

model UserLocationAccess {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, locationId])
  @@index([userId])
  @@index([locationId])
  @@map("user_location_access")
}

model PurchasePayment {
  id         String    @id @default(uuid())
  companyId  String
  company    Company   @relation(fields: [companyId], references: [id])
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id])
  purchaseId String
  purchase   Purchase  @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  amount     Float
  method     String    @default("cash")
  account    String    @default("Cash")
  reference  String?
  notes      String?
  paidAt     DateTime  @default(now())
  createdAt  DateTime  @default(now())

  @@index([purchaseId])
  @@index([companyId, paidAt])
  @@map("purchase_payments")
}

/// Bill of materials: what it takes to make `outputQuantity` units of a product.
model Bom {
  id             String    @id @default(uuid())
  companyId      String
  company        Company   @relation(fields: [companyId], references: [id])
  productId      String
  product        Product   @relation(fields: [productId], references: [id])
  /// The quantity of finished product the lines below produce (e.g. 1 or 100).
  outputQuantity Float     @default(1)
  notes          String?
  lines          BomLine[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([companyId, productId])
  @@map("boms")
}

model BomLine {
  id           String  @id @default(uuid())
  bomId        String
  bom          Bom     @relation(fields: [bomId], references: [id], onDelete: Cascade)
  componentId  String
  component    Product @relation(fields: [componentId], references: [id])
  /// Quantity of the component needed for the BOM's outputQuantity.
  quantity     Float
  /// Expected extra usage for normal waste, e.g. 2 = 2% more.
  scrapPercent Float   @default(0)
  sortOrder    Int     @default(0)

  @@map("bom_lines")
}

/// One production run: materials go into work in progress, finished goods come out.
model ProductionOrder {
  id               String               @id @default(uuid())
  companyId        String
  company          Company              @relation(fields: [companyId], references: [id])
  locationId       String?
  location         Location?            @relation(fields: [locationId], references: [id])
  /// MO-0001, unique per company
  number           String
  productId        String
  product          Product              @relation("ProductionOutput", fields: [productId], references: [id])
  /// draft | in_progress | completed | cancelled
  status           String               @default("draft")
  plannedQuantity  Float
  producedQuantity Float                @default(0)
  /// Cost of materials issued and not returned (the work-in-progress value).
  materialCost     Float                @default(0)
  /// Cost per good unit produced (set on completion).
  unitCost         Float                @default(0)
  plannedDate      DateTime?
  startedAt        DateTime?
  completedAt      DateTime?
  cancelledAt      DateTime?
  notes            String?
  createdById      String?
  materials        ProductionMaterial[]
  outputBatches    InventoryBatch[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  /// Made to order for this customer (optional).
  customerId String?
  customer   Customer?         @relation(fields: [customerId], references: [id])
  /// Agreed selling price per unit for a customer order (optional).
  unitPrice  Float?
  deposits   CustomerDeposit[]
  invoices   Invoice[]

  @@unique([companyId, number])
  @@index([companyId, status])
  @@map("production_orders")
}

/// A material on a production order: planned from the BOM, issued as used.
model ProductionMaterial {
  id              String            @id @default(uuid())
  orderId         String
  order           ProductionOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product           @relation(fields: [productId], references: [id])
  plannedQuantity Float             @default(0)
  issuedQuantity  Float             @default(0)
  issuedCost      Float             @default(0)
  issues          ProductionIssue[]

  @@unique([orderId, productId])
  @@map("production_materials")
}

/// Exactly which stock batch each issued quantity came from (traceability;
/// unused material goes back to the same batch at the same cost).
model ProductionIssue {
  id         String             @id @default(uuid())
  materialId String
  material   ProductionMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  batchId    String
  batch      InventoryBatch     @relation(fields: [batchId], references: [id])
  /// Positive when issued; negative when returned.
  quantity   Float
  unitCost   Float
  createdAt  DateTime           @default(now())

  @@index([materialId])
  @@map("production_issues")
}

/// Stock moved from one location to another. Batches keep their cost,
/// received date and source, so the company's stock value does not change.
model StockTransfer {
  id             String              @id @default(uuid())
  companyId      String
  company        Company             @relation(fields: [companyId], references: [id])
  /// TR-0001, TR-0002, … per company
  number         String
  fromLocationId String
  fromLocation   Location            @relation("TransferFrom", fields: [fromLocationId], references: [id])
  toLocationId   String
  toLocation     Location            @relation("TransferTo", fields: [toLocationId], references: [id])
  notes          String?
  createdById    String?
  createdAt      DateTime            @default(now())
  lines          StockTransferLine[]

  @@unique([companyId, number])
  @@index([companyId, createdAt])
  @@map("stock_transfers")
}

model StockTransferLine {
  id         String        @id @default(uuid())
  transferId String
  transfer   StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  productId  String
  product    Product       @relation(fields: [productId], references: [id])
  quantity   Float
  /// Cost of the batches moved (unchanged by the move).
  totalCost  Float         @default(0)

  @@map("stock_transfer_lines")
}

/// Goods returned by a customer, or a credit for part of an invoice. The
/// invoice itself is never changed: its balance is total - amountPaid -
/// creditedAmount.
model CreditNote {
  id                String           @id @default(uuid())
  companyId         String
  company           Company          @relation(fields: [companyId], references: [id])
  locationId        String?
  location          Location?        @relation(fields: [locationId], references: [id])
  invoiceId         String
  invoice           Invoice          @relation(fields: [invoiceId], references: [id])
  /// CN-0001, CN-0002, … per company
  number            String
  reason            String?
  /// Value of the lines after the invoice's discount, before VAT.
  subtotal          Float
  taxTotal          Float            @default(0)
  total             Float
  /// Part of the total that reduced what the customer owed.
  appliedAmount     Float            @default(0)
  /// Part of the total paid back to the customer.
  refundAmount      Float            @default(0)
  refundAccountName String?
  /// Cost of the goods put back into stock.
  costReturned      Float            @default(0)
  createdById       String?
  createdAt         DateTime         @default(now())
  lines             CreditNoteLine[]

  @@unique([companyId, number])
  @@index([invoiceId])
  @@map("credit_notes")
}

model CreditNoteLine {
  id            String      @id @default(uuid())
  creditNoteId  String
  creditNote    CreditNote  @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)
  invoiceItemId String
  invoiceItem   InvoiceItem @relation(fields: [invoiceItemId], references: [id])
  productId     String?
  description   String
  quantity      Float
  /// Price per unit after the invoice's discount, before VAT.
  unitPrice     Float
  total         Float
  /// Put back into stock (false for damaged goods that are only credited).
  restocked     Boolean     @default(true)
  cost          Float       @default(0)

  @@map("credit_note_lines")
}

/// Money received from a customer before they are invoiced (e.g. a deposit
/// on a production order). Held as a liability until applied to an invoice
/// or refunded.
model CustomerDeposit {
  id                String           @id @default(uuid())
  companyId         String
  company           Company          @relation(fields: [companyId], references: [id])
  locationId        String?
  location          Location?        @relation(fields: [locationId], references: [id])
  customerId        String
  customer          Customer         @relation(fields: [customerId], references: [id])
  productionOrderId String?
  productionOrder   ProductionOrder? @relation(fields: [productionOrderId], references: [id])
  /// DEP-0001, DEP-0002, … per company
  number            String
  amount            Float
  /// Used to pay invoices.
  appliedAmount     Float            @default(0)
  /// Paid back to the customer.
  refundedAmount    Float            @default(0)
  method            String           @default("cash")
  accountName       String?
  reference         String?
  notes             String?
  receivedAt        DateTime         @default(now())
  createdById       String?
  createdAt         DateTime         @default(now())
  applications      Payment[]

  @@unique([companyId, number])
  @@index([customerId])
  @@index([productionOrderId])
  @@map("customer_deposits")
}
